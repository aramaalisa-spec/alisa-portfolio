---
import PageLayout from '../layouts/PageLayout.astro';

// import portrait from '../assets/portrait.jpg';
---

<PageLayout
	title="About the studio"
	description="We shape product, brand, and code for mission-driven teams."
	eyebrow="Studio"
>
	<section class="content-shell py-12 space-y-16">

		{/* INTRO WITH PHOTO */}
		<div class="flex gap-8 items-start">
			<div class="shrink-0">
				<img
					src="/portrait.jpg"
					alt="Your name"
					class="w-[360px] object-cover" 
				/>
			</div>
			<div class="space-y-3 max-w-2xl">
    <p class="m-0 text-ink text-2xl font-semibold leading-tight">Hello, I am Alisa</p>
	<br>
    <p class="m-0 text-ink">You've seen the work, you might have even read the resume. Let's get acquainted!</p>
    <p>
		<br>
        I have a small pottery studio where I create and decompress. I like experimenting with mixed media, combining ceramics, wood, and upcycled textiles. You can see what I make over here: <a href="http://www.instagram.com/hello_pilcrow/">@hello_pilcrow</a>
    </p>
    <p>I love art and enjoy urban and live model sketching. </p>
	<br>
	<p>
		P.S. If you are looking for the serious stuff, it's <a href="https://resume.alisaarama.com/">here.</a>
		<br>
		<br>
		<br>
		<p></p>Email me directly at:</p>
		<p>arama.alisa@proton.me</p>
	</p>
</div>
		</div>

		{/* SCRAPBOOK */}
<div class="space-y-4">
    <div class="grid gap-4" style="grid-template-columns: 3fr 2fr;">
        <div class="flex items-center justify-left h-80"><img src="/live_sketch.png" alt="" class="max-h-full max-w-full object-contain" /></div>
        <div class="flex items-center justify-center h-80"><img src="/quote.png" alt="" class="max-h-full max-w-full object-contain" /></div>
    </div>
    <div class="grid grid-cols-3 gap-4">
        <div class="flex items-center justify-center h-48"><img src="/oyster.jpeg" alt="" class="max-h-full max-w-full object-contain" /></div>
        <div class="flex items-center justify-center h-48"><img src="/pilcrow.jpeg" alt="" class="max-h-full max-w-full object-contain" /></div>
        <div class="flex items-center justify-center h-48"><img src="/maneki-neko.png" alt="" class="max-h-full max-w-full object-contain" /></div>
    </div>

</div>