---
import PageLayout from '../layouts/PageLayout.astro';

// import portrait from '../assets/portrait.jpg';
---

<PageLayout
	title="About the studio"
	description="We shape product, brand, and code for mission-driven teams."
	eyebrow="Studio"
>
	<section class="content-shell py-12 space-y-16">

		{/* INTRO WITH PHOTO */}
		<div class="flex gap-8 items-start">
			<div class="shrink-0">
				<img
					src="/placeholder-portrait.jpg"
					alt="Your name"
					class="w-32 h-32 rounded-full object-cover object-top"
				/>
			</div>
			<div class="space-y-3 max-w-2xl">
				<p class="m-0 text-ink text-2xl font-semibold leading-tight">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
				<p class="m-0 text-muted">Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
			</div>
		</div>

		{/* BOOKS */}
		<div class="space-y-4">
			<h2 class="text-sm font-bold uppercase tracking-widest text-muted">Recently read</h2>
			<div class="grid grid-cols-1 gap-6">

				<div class="flex gap-4 items-start">
					<img src="https://placehold.co/60x90" alt="Book cover" class="shrink-0 w-12 object-cover" />
