---
import PageLayout from '../layouts/PageLayout.astro';

// import portrait from '../assets/portrait.jpg';
---

<PageLayout
	title="About the studio"
	description="We shape product, brand, and code for mission-driven teams."
	eyebrow="Studio"
>
	<section class="content-shell py-12 space-y-16">

		{/* INTRO WITH PHOTO */}
		<div class="flex gap-8 items-start">
			<div class="shrink-0">
				<img
					src="/portrait.jpg"
					alt="Your name"
					class="w-[360px] object-cover" 
				/>
			</div>
			<div class="space-y-3 max-w-2xl">
    <p class="m-0 text-ink text-2xl font-semibold leading-tight">Hello, I am Alisa</p>
	<br>
    <p class="m-0 text-muted">You've seen the work, you might have even read the resume. Let's get acquainted!</p>
    <p>
		<br>
        I have a small pottery studio where I create and decompress. I like experimenting with mixed media, combining ceramics, wood, and upcycled textiles. You can see what I make over here: <a href="http://www.instagram.com/hello_pilcrow/">@hello_pilcrow</a>
    </p>
    <p>I love art and enjoy urban and live model sketching. </p>
	<br>
	<p>
		P.S. If you are looking for the serious stuff, it's <a href="https://resume.alisaarama.com/">here.</a>
	</p>
</div>
