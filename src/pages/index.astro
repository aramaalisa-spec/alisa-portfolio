---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import SectionList from '../components/SectionList.astro';
import Social from '../components/Social.astro';

import { getSite } from '../utils/consts';
import ProjectList from '../components/ProjectList.astro';

const site = await getSite();
---

<PageLayout
	title={site.author.name || 'Alisa Arama'}
>
	<Hero
		title={site.author.name || 'Alisa Arama'}
		description={site.author.bio || 'Welcome to my personal website.'}
		role={site.author.role}
		location={site.author.location}
		actions={[
			{ label: 'My work', href: '/blog' },
			{ label: 'Resume', href: 'https://resume.domain.com' },
		]}
	/>

	

	<PostList
		heading="My work"
		limit={6}
		viewAllHref="/blog"
	/>
	<SectionList
		heading="Work Experience"
		items={[
			{
				title: "Product Designer — Skyland Family, Berlin",
				description: "Invitation-only investment platform for family offices and wealthy individuals. Planned and executed MVP; working across the full product lifecycle — research, prototyping, final UI, handoff, sprint planning, analytics, and backlog management.",
				datetime: "2020-01",
				dateLabel: "2020–2025",
			},
			{
				title: "Designer (Graphic, UX/UI) — Bookster, Bucharest",
				description: "Modern online library offered as an employment benefit. Managed all visual touchpoints, including landing pages, campaigns, digital and printed assets. Later transitioned into a UX role focused on User Retention — building and iterating on the main library platform, in a dynamic and lean start-up environment.",
				datetime: "2015-01",
				dateLabel: "2015–2018",
			},
			{
				title: "Graphic Designer — AnnArt Gallery, Bucharest",
				description: "Designed and produced exhibition materials across print and digital: invitations, posters, press assets, and social media. Created art catalogues, accountable for layout, DTP, production, distribution, and launch.",
				datetime: "2014-01",
				dateLabel: "2014–2015",
			},
		]}
	/>

	<SectionList
		heading="Education"
		items={[
			{
				title: "Graphic Design and Visual Communication, BA",
				description: "National University of Arts, Bucharest",
				datetime: "2014",
				dateLabel: "Class of 2014",
			},
			
		]}
	/>

	<SectionList
    heading="Skills & Languages"
    items={[
        {
            title: "Product Design",
            description: "Full-cycle product design, Research & Analysis, Prototyping, Backlog Management & Planning, Product Management, AI-assisted Design Tools"
        },
        {
            title: "Languages",
            description: "Romanian and Russian — native. English — fluent. German — B2.",
        },
    ]}
>
    <div class="flex gap-4 items-center">
        
            <a href="/Alisa_Arama_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm 2xl:text-xl text-base-600 uppercase"
        >
            Open CV ↑
        </a>
        
            <a href="/Alisa_Arama_Resume.pdf"
            download
            class="text-sm 2xl:text-xl text-base-600 uppercase"
        >
            Download PDF ↓
        </a>
    </div>
</SectionList>

</PageLayout>