---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Prose from '../components/Prose.astro';
import Card from '../components/Card.astro';
import { slugify, withBase } from '../utils/slugify';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	Content?: any;
	tags?: string[];
	prevPost?: any;
	nextPost?: any;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], Content, prevPost, nextPost } = Astro.props as Props;
---

<BaseLayout title={title} description={description} image={heroImage}>
    <div class="flex-1 flex flex-col pt-4 md:pt-8 pb-8 md:pb-16 lg:pb-20 space-y-10 md:space-y-16">
    <article class="post-page max-w-4xl w-full mx-auto">
        <header class="section-heading">
                {tags.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-2 text-sm text-muted">
                        {tags.map((tag) => (
                            <li class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1">
                                <a class="hover:text-ink" href={withBase(`/tags/${slugify(tag)}/`)}>{tag}</a>
                            </li>
                        ))}
                    </ul>
                )}
        </header>

        <section class="post-article w-full min-w-0">
            <Prose>
                {Content ? <Content /> : <slot />}
            </Prose>
        </section>

        {(prevPost || nextPost) && (
            <nav class="grid grid-cols-2 gap-4 mt-16 pt-8 border-t border-border">
                <div>
                    {prevPost && (
                        <>
                        <a href={`/blog/${prevPost.id}/`} class="text-xs text-muted uppercase tracking-widest mb-2 hover:text-ink">← Previous Project</a>                            <Card
                                title={prevPost.data.title}
                                href={`/blog/${prevPost.id}/`}
                                description={prevPost.data.description}
                                image={prevPost.data.heroImage}
                            />
                        </>
                    )}
                </div>
                <div>
                    {nextPost && (
                        <>
                            <a href={`/blog/${nextPost.id}/`} class="text-xs text-muted uppercase tracking-widest mb-2 hover:text-ink">Next Project→</a>
                            <Card
                                title={nextPost.data.title}
                                href={`/blog/${nextPost.id}/`}
                                description={nextPost.data.description}
                                image={nextPost.data.heroImage}
                            />
                        </>
                    )}
                </div>
            </nav>
        )}

    </article>
    </div>
    <script>
        document.querySelectorAll('.post-article img').forEach(img => {
            img.setAttribute('loading', 'lazy');
        });
    </script>
</BaseLayout>